@import 'themes.styl'

// ============================================================
// 用户链接（components/user/UserLink.vue）
//
// 五个入口共用：文章列表 / 文章详情 / 评论区 / 留言板 / 聊天室。
// 放在全局层的原因：它被 article / comment / wall / chat 四个目录引用，
// 写在任何一个子目录里都会变成「跨兄弟目录依赖」（与 manage.styl / comment.styl 同一做法）。
//
// 只做三件事：
//   ① 圆形头像 + 三档尺寸（xs 聊天气泡 / sm 列表与评论 / md 详情）
//   ② 可选昵称（评论/留言/聊天不渲染，它们自己已有昵称元素）
//   ③ 可点态的 cursor 与 hover —— **不改任何一处的既有颜色/间距**，
//      这样插进评论或留言时不会把那一块的排版顶乱。
//
// ⚠ 声明统一写「属性: 值」带冒号形式 —— Stylus 对「无冒号 + 值是多段」有歧义，
//   紧跟缩进更深的嵌套块时会被当成选择器解析、整条静默丢失（详见 component.styl）。
// ============================================================

.blog-user--link
  display: inline-flex
  align-items: center
  gap: $theme-spacing.xs
  // 这一层不铺开：宽度由内容决定，避免插进卡片时把整行撑开
  max-width: 100%
  min-width: 0

  // 头像：靠 aspect-ratio 锁成圆的正方形（不同档位只改 width）
  .blog-user--avatar
    flex: 0 0 auto
    display: block
    aspect-ratio: 1 / 1
    border-radius: 50%
    overflow: hidden
    background-color: var(--theme-bgc-input)

    // el-image 渲染出来是个 div，默认 inline-block 会把宽度交给图片自身
    .el-image__inner
      display: block
      width: 100%
      height: 100%

  // 头像挂了（URL 失效）时的占位 —— 用 iconfont 而不是浏览器自带的破图标
  .blog-user--avatar_fallback
    display: flex
    align-items: center
    justify-content: center
    width: 100%
    height: 100%
    color: var(--theme-font-placeholder)

  .blog-user--name
    flex: 0 1 auto
    min-width: 0
    overflow: hidden
    white-space: nowrap
    text-overflow: ellipsis
    color: var(--theme-font-light)

  // 只有「拿得到 id」才给指针与 hover —— 拿不到的作者点了也不跳，
  //   给 cursor: pointer 会骗用户（见 UserLink.vue 的 clickable 说明）
  &.is-clickable
    cursor: pointer

    &:hover .blog-user--name
      color: var(--theme-font-fst)
      text-decoration: underline

// ── 三档尺寸 ──────────────────────────────────────────────
// xs：聊天室气泡（原来的 .blog-chat--bubble_avatar 尺寸偏小）
// sm：文章列表 / 详情 / 评论 / 留言（与 .blog-comment--avatar 一档）
// md：文章详情顶部那一行（比 sm 大一圈，和标题行更搭）
.blog-user--link.is-xs
  .blog-user--avatar
    width: 24px
  .blog-user--avatar_fallback
    font-size: 12px
  .blog-user--name
    font-size: $theme-fz.sm

.blog-user--link.is-sm
  .blog-user--avatar
    width: 32px
  .blog-user--avatar_fallback
    font-size: 16px
  .blog-user--name
    font-size: $theme-fz.base

.blog-user--link.is-md
  .blog-user--avatar
    width: 40px
  .blog-user--avatar_fallback
    font-size: 20px
  .blog-user--name
    font-size: $theme-fz.lg
    font-weight: 700
